/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.supabase.co; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; worker-src 'self' blob:; manifest-src 'self'; media-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
  Strict-Transport-Security: max-age=31536000

/api/*
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow, noarchive

/auth/*
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow, noarchive

/checkout/*
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow, noarchive

/my-images
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow, noarchive

/sign-in
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow, noarchive
