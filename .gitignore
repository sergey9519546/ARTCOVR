# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep documented placeholders in version control)
.env*
!.env.example
!supabase/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt
server.log

# Skills directory
/skills/

# Local agent execution ledger
/.superpowers/

# Supabase local runtime and generated secrets
/supabase/.branches/
/supabase/.temp/

# Sites deployment metadata is generated during private staging publish
/.openai/

# Local catalog review artifacts and private source locators (never deployed)
/outputs/catalog/review-assets/
/outputs/catalog/thumbnails/
/outputs/catalog/*.ndjson
/outputs/catalog/*.xlsx
/outputs/catalog/*.png
/outputs/catalog/*.private.json
/catalog/candidates.csv
/catalog/candidates.json
