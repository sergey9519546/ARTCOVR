#!/bin/sh
# Enforcement gate: typecheck + tests before any commit. FAIL-MODE closed.
# Bootstrap exception: on a checkout that predates the gate (no gate.mjs),
# warn and allow — blocking every historical branch would strand the owner.
# doctor flags this state; the gate branch itself is always enforced.
if [ ! -f "scripts/agent/gate.mjs" ]; then
  echo "[gate] scripts/agent/gate.mjs absent on this checkout - gate not enforced here" >&2
  exit 0
fi
# Resolve node from PATH first, then the known Windows install. Mirrors
# resolveBun() in gate.mjs: unresolvable denies (fail closed).
if command -v node >/dev/null 2>&1; then
  NODE_BIN=node
elif [ -x "/c/Program Files/nodejs/node" ]; then
  NODE_BIN="/c/Program Files/nodejs/node"
else
  echo "[gate] node unresolvable on PATH or at the known Windows install - denying" >&2
  exit 1
fi
exec "$NODE_BIN" scripts/agent/gate.mjs pre-commit
