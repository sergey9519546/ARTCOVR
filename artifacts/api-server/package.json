{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts src/*.test.ts",
    "stripe:catalog:cleanup": "tsx src/stripeCatalogCleanupCli.ts",
    "stripe:catalog:reconcile": "tsx src/stripeCatalogCleanupCli.ts --reconcile-only"
  },
  "dependencies": {
    "@clerk/express": "^2.1.64",
    "@clerk/shared": "^4.30.2",
    "@google-cloud/storage": "^7.16.0",
    "@replit/connectors-sdk": "^0.4.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-openai-ai-server": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "httpxy": "^0.5.5",
    "mppx": "^0.9.3",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.35.5",
    "stripe": "^22.6.0",
    "viem": "^2.56.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.1",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.2.0",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
