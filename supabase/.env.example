SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
APP_ORIGIN=http://localhost:3000
OPENAI_API_KEY=YOUR_SERVER_ONLY_OPENAI_KEY
# Do not silently substitute this configured model if it is unavailable.
OPENAI_IMAGE_MODEL=gpt-image-2-2026-04-21
# Leaves room inside the Edge wall-clock limit for validation, watermarking,
# upload finalization, and cleanup, and stays below the 180s watchdog cutoff.
# Valid range: 30000–130000.
OPENAI_IMAGE_TIMEOUT_MS=115000
STRIPE_SECRET_KEY=YOUR_SERVER_ONLY_STRIPE_KEY
STRIPE_WEBHOOK_SECRET=YOUR_SERVER_ONLY_WEBHOOK_SECRET
CRON_SECRET=YOUR_LONG_RANDOM_SCHEDULER_SECRET
# Trusted Cloudflare Images/Worker endpoint; it must return a raster WebP.
WATERMARK_RENDER_URL=https://images.example/workers/render-watermark
WATERMARK_RENDER_TOKEN=

# Reference-upload re-encoder (bytes in -> bounded WebP out; see
# supabase/functions/upload-reference/transcode.ts for the exact contract and
# mini-services/reference-transcode for a self-hostable implementation).
# Missing values are a hard 500 by design: client bytes are never stored raw.
REFERENCE_TRANSCODE_URL=https://images.example/workers/reference-transcode
REFERENCE_TRANSCODE_TOKEN=
