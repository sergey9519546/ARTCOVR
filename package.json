{
  "name": "artcovr",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node --experimental-strip-types scripts/catalog/prune-deployment-assets.ts && node --experimental-strip-types scripts/catalog/verify-export-isolation.ts",
    "start": "next start",
    "lint": "eslint src tests scripts --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types",
    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "test:e2e:ui": "node node_modules/@playwright/test/cli.js test --ui",
    "verify": "npm run test && npm run typecheck && npm run lint && npm run build",
    "catalog:validate": "node --experimental-strip-types scripts/catalog/validate.ts",
    "catalog:validate:metadata": "node --experimental-strip-types scripts/catalog/validate-curation-metadata.ts",
    "catalog:curate": "node --experimental-strip-types scripts/catalog/curate-launch.ts",
    "catalog:approval:build": "node scripts/catalog/run-workbook-tool.mjs build-approval-workbook.mjs",
    "catalog:approval:import": "node --experimental-strip-types scripts/catalog/run-workbook-tool.mjs import-approval-workbook.mjs",
    "catalog:approval:verify": "node scripts/catalog/run-workbook-tool.mjs verify-approval-workbook.mjs",
    "catalog:swap:dry-run": "node --experimental-strip-types scripts/catalog/swap-launch-works.ts",
    "catalog:swap:apply": "node --experimental-strip-types scripts/catalog/swap-launch-works.ts --apply",
    "catalog:project": "node --experimental-strip-types scripts/catalog/project-approved-catalog.ts",
    "catalog:project:check": "node --experimental-strip-types scripts/catalog/project-approved-catalog.ts --check",
    "catalog:launch:check": "node --experimental-strip-types scripts/catalog/project-approved-catalog.ts --check --launch",
    "catalog:storage:plan": "node --experimental-strip-types scripts/catalog/plan-storage-upload.ts --write-plan",
    "catalog:prune:deployment": "node --experimental-strip-types scripts/catalog/prune-deployment-assets.ts",
    "catalog:revocations:dry-run": "node --experimental-strip-types scripts/catalog/build-revocations.ts",
    "catalog:revocations:write": "node --experimental-strip-types scripts/catalog/build-revocations.ts --write",
    "catalog:visual-index": "node --experimental-strip-types scripts/catalog/build-visual-index.ts",
    "catalog:supabase:dry-run": "node --experimental-strip-types scripts/catalog/build-supabase-import.ts",
    "catalog:supabase:write": "node --experimental-strip-types scripts/catalog/build-supabase-import.ts --write",
    "gen-icons": "bun scripts/gen-icons.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "^16.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  },
  "imports": {
    "#staging-catalog": "./src/lib/artcovr/curated-review.json",
    "#staging-intro": "./src/lib/artcovr/staging-intro.json"
  }
}